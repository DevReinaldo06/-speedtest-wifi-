# Copie este arquivo para .env e ajuste os valores se precisar.
# O sistema funciona sem .env: todos os valores abaixo têm padrão.

# Porta do servidor (no Render, a porta é definida pela própria plataforma)
PORT=3000

# Caminho do arquivo SQLite (use :memory: para um banco temporário)
DB_PATH=./data/speedtest.db

# Tamanho máximo, em MB, de cada requisição do teste de velocidade
MAX_DOWNLOAD_MB=50
MAX_UPLOAD_MB=25

# Limite de requisições por IP (janela em milissegundos)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# 1 = modo rápido (testes curtos, usado nos testes E2E da pipeline)
SPEEDTEST_FAST=0

# Identificação do commit exibida em /api/health (definida pelo build/deploy)
GIT_COMMIT=
