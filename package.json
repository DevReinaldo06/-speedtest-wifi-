{
  "name": "speedtest-wifi",
  "version": "1.0.0",
  "description": "Sistema web que mede velocidade de download, upload e ping e guarda o histórico. Projeto da matéria Cultura e Práticas DevOps.",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "build": "bash scripts/build.sh",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.unit.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js --coverage",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
